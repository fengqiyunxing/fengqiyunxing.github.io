---
import { commentConfig } from "@/config/commentConfig";
import { url } from "@/utils/url-utils";

interface Props {
	path: string;
}

const {
	jsUrl = "https://registry.npmmirror.com/twikoo/1.7.13/files/dist/twikoo.min.js",
	cssUrl,
	...twikooConfig
} = commentConfig.twikoo ?? { envId: "" };
const config = {
	...twikooConfig,
	el: "#tcomment",
	path: Astro.props.path.replace(/\/$/, ""),
};
---

<twikoo-comments
  id="tcomment"
  class="block"
  data-config={JSON.stringify(config)}
  data-sdk-url={jsUrl}
></twikoo-comments>
{cssUrl && <link rel="stylesheet" href={cssUrl.startsWith("http") ? cssUrl : url(cssUrl)} />}
<script>
  import type { CommentConfig } from "@/types/commentConfig";

  type TwikooOptions = NonNullable<CommentConfig["twikoo"]> & {
    el: string;
    path: string;
  };
  declare global {
    interface Window {
      twikoo: { init(options: TwikooOptions): Promise<void> };
    }
  }
  let sdk: Promise<void>;

  class TwikooComments extends HTMLElement {
    async connectedCallback() {
      const config: TwikooOptions = JSON.parse(this.dataset.config!);
      const path = window.location.pathname === "/dynamic/comments/"
        ? new URLSearchParams(window.location.search).get("path") ?? config.path
        : config.path;

      sdk ??= new Promise((resolve, reject) => {
        const script = document.createElement("script");
        script.src = this.dataset.sdkUrl!;
        script.setAttribute("data-swup-ignore-script", "");
        script.onload = () => resolve();
        script.onerror = () => reject(new Error("Could not load Twikoo"));
        document.body.append(script);
      });

      try {
        await sdk;
        if (this.isConnected) await window.twikoo.init({ ...config, path });
      } catch (error) {
        console.error("[Twikoo] Initialization failed:", error);
      }
    }
  }

  customElements.define("twikoo-comments", TwikooComments);
</script>
